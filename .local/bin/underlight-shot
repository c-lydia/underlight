#!/usr/bin/env bash
set -u

mode="${1:-area}"
directory="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$directory"
file="$directory/$(date '+Screenshot_%Y-%m-%d_%H-%M-%S').png"

if command -v grim >/dev/null; then
  if [[ "$mode" == area ]] && command -v slurp >/dev/null; then
    geometry="$(slurp)" || exit 0
    grim -g "$geometry" "$file"
  else
    grim "$file"
  fi
elif command -v gnome-screenshot >/dev/null; then
  if [[ "$mode" == area ]]; then
    gnome-screenshot -a -f "$file"
  else
    gnome-screenshot -f "$file"
  fi
else
  notify-send 'Screenshot unavailable' 'Install grim and slurp to enable screenshots.'
  exit 1
fi

command -v wl-copy >/dev/null && wl-copy --type image/png < "$file"
notify-send 'Screenshot saved' "$file"
