#!/usr/bin/env bash
set -uo pipefail

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$@" || true
  fi
}

fail() {
  printf 'underlight-shot: %s\n' "$1" >&2
  notify 'Screenshot failed' "$1"
  exit 1
}

mode="${1:-area}"
case "$mode" in
  area|screen) ;;
  -h|--help) printf 'Usage: underlight-shot [area|screen]\n'; exit 0 ;;
  *) printf 'Usage: underlight-shot [area|screen]\n' >&2; exit 2 ;;
esac
(( $# <= 1 )) || { printf 'Usage: underlight-shot [area|screen]\n' >&2; exit 2; }

geometry=''
if command -v grim >/dev/null 2>&1; then
  backend=grim
  if [[ "$mode" == area ]]; then
    command -v slurp >/dev/null 2>&1 || fail 'Area capture requires slurp.'
    geometry="$(slurp)" || exit 0
    [[ -n "$geometry" ]] || exit 0
    # The selection layer has closed; let the compositor redraw before capture.
    # Hyprland also disables animation for this layer in looknfeel.conf.
    sleep 0.2 || fail 'Could not wait for the selection overlay to close.'
  fi
elif command -v gnome-screenshot >/dev/null 2>&1; then
  backend=gnome-screenshot
else
  fail 'Install grim and slurp to enable screenshots.'
fi

pictures="${XDG_PICTURES_DIR:-}"
if [[ -z "$pictures" ]] && command -v xdg-user-dir >/dev/null 2>&1; then
  pictures="$(xdg-user-dir PICTURES)" || pictures=''
fi
directory="${pictures:-$HOME/Pictures}/Screenshots"
mkdir -p -- "$directory" || fail "Cannot create $directory"
stamp="$(date '+Screenshot_%Y-%m-%d_%H-%M-%S')" || fail 'Cannot create screenshot timestamp.'
file="$(mktemp "$directory/${stamp}_XXXXXX.png")" || fail "Cannot create a screenshot in $directory"
saved=0
cleanup() { if (( ! saved )); then rm -f -- "$file"; fi; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ "$backend" == grim ]]; then
  if [[ "$mode" == area ]]; then
    grim -g "$geometry" "$file" || fail 'grim could not capture the selected area.'
  else
    grim "$file" || fail 'grim could not capture the screen.'
  fi
elif [[ "$mode" == area ]]; then
  gnome-screenshot -a -f "$file" || fail 'gnome-screenshot could not capture the selected area.'
else
  gnome-screenshot -f "$file" || fail 'gnome-screenshot could not capture the screen.'
fi
[[ -s "$file" ]] || fail 'The capture produced an empty image.'
saved=1

if command -v wl-copy >/dev/null 2>&1; then
  if ! wl-copy --type image/png < "$file"; then
    printf 'underlight-shot: saved %s, but clipboard copy failed\n' "$file" >&2
    notify 'Screenshot saved; clipboard failed' "$file"
    exit 0
  fi
fi
notify 'Screenshot saved' "$file"
