#!/usr/bin/env bash

set -euo pipefail

command -v wofi >/dev/null 2>&1 || { printf 'underlight-gpu-menu: wofi is not installed\n' >&2; exit 1; }
choice=$(printf '%s\n' \
  'AI tools' \
  'Run command on NVIDIA' \
  'Laptop & GPU dashboard' \
  'GPU diagnostics' \
  'Power profile' |
  wofi --dmenu --insensitive --prompt 'GPU & compute') || exit

case $choice in
  'AI tools') exec underlight-ai menu ;;
  'Run command on NVIDIA')
    requested=$(wofi --dmenu --prompt 'NVIDIA command') || exit
    [[ -n $requested ]] || exit 0
    exec kitty --class underlight-gpu-app --title "NVIDIA · $requested" sh -lc 'underlight-profile ai -- "$@"' _ sh -lc "$requested"
    ;;
  'Laptop & GPU dashboard') exec underlight-laptop ;;
  'GPU diagnostics') exec underlight-gpu-check --terminal ;;
  'Power profile') exec underlight-profile menu ;;
esac
