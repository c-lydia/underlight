#!/usr/bin/env bash
set -euo pipefail

with_android=false
case ${1:-} in
  --with-android) with_android=true ;;
  '') ;;
  *) printf 'Usage: underlight-install-extras [--with-android]\n' >&2; exit 2 ;;
esac

sudo apt-get update
sudo apt-get install -y \
  mako-notifier \
  grim \
  slurp \
  wl-clipboard \
  cliphist \
  brightnessctl \
  playerctl \
  pavucontrol \
  mesa-utils \
  screen \
  switcheroo-control \
  network-manager \
  network-manager-gnome

if [[ $with_android == true ]]; then underlight-android setup; fi

printf '\nExtras installed. Log out and back into Hyprland once to start every helper.\n'
