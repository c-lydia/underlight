#!/usr/bin/env bash
set -euo pipefail

sudo apt-get update
sudo apt-get install -y \
  mako-notifier \
  grim \
  slurp \
  wl-clipboard \
  cliphist \
  brightnessctl \
  playerctl \
  pavucontrol \
  switcheroo-control \
  network-manager-gnome

printf '\nExtras installed. Log out and back into Hyprland once to start every helper.\n'
