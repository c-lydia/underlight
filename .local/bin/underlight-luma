#!/usr/bin/env python3
"""Luma's desktop avatar. Preferences are shared with the Obsidian companion."""
import argparse
import ctypes
import fcntl
import json
import math
import os
import signal
from pathlib import Path
import subprocess
import tempfile
import time
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'share/underlight'))
from workflows.privacy import mode as privacy_mode, MODES

ASSETS = Path(__file__).resolve().parents[1] / 'share/underlight/luma'
STATE = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'underlight/luma.json'
AGENTS = json.loads((ASSETS / 'agents.json').read_text())
PANEL_BOTTOM = 155
PANEL_TOP_GAP = 48


def panel_size(monitor_width, monitor_height, content_height):
    """Keep a useful viewport above the avatar, within the logical display size."""
    return (max(1, min(360, monitor_width - 36)),
            max(1, min(content_height, monitor_height - PANEL_BOTTOM - PANEL_TOP_GAP)))


def read_state():
    try:
        value = json.loads(STATE.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(**changes):
    state = {**read_state(), **changes}
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temp = STATE.with_name(f'.luma-{os.getpid()}.json')
    temp.write_text(json.dumps(state, indent=2) + '\n')
    temp.replace(STATE)
    return state


def launch_command(agent, state):
    command = [str(Path.home() / '.local/bin/underlight-ai'), agent['command']]
    directory = Path(state.get('vault') or Path.home()).expanduser()
    if not directory.is_dir():
        raise ValueError(f'Working folder does not exist: {directory}. Update vault in {STATE}.')
    if agent['id'] == 'qwen':
        command.append('qwen3:4b')
    elif agent['id'] != 'rag':
        command.append(str(directory))
    return command, directory


class LaunchJob:
    """Watch the launcher without blocking GTK or losing its error output."""
    def __init__(self, agent, state):
        command, directory = launch_command(agent, state)
        self.name = agent['name']
        self.started = time.monotonic()
        self.announced = False
        self.log = tempfile.TemporaryFile()
        environment = dict(os.environ)
        rag_config = directory / '.obsidian/underlight-rag.yaml'
        if agent['id'] == 'rag' and rag_config.is_file():
            environment['RAG_CONFIG'] = str(rag_config)
        try:
            self.process = subprocess.Popen(command, cwd=directory, stdout=self.log,
                                            stderr=subprocess.STDOUT, start_new_session=True, env=environment)
        except OSError:
            self.log.close()
            raise

    def failure(self, code):
        self.log.seek(0, os.SEEK_END)
        size = self.log.tell()
        self.log.seek(max(0, size - 4096))
        detail = self.log.read().decode(errors='replace').strip()
        return f'{self.name} could not open (exit {code}).\n{detail or "Try underlight-ai status in a terminal."}'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--show', action='store_true')
    parser.add_argument('--menu', action='store_true', help='show Luma and open the launcher')
    parser.add_argument('--hide', action='store_true')
    parser.add_argument('--status', action='store_true')
    args = parser.parse_args()
    if args.status:
        print(json.dumps(read_state(), indent=2)); return
    if args.hide:
        save_state(desktopHidden=True); return
    if args.show or args.menu:
        save_state(desktopHidden=False)
    lock_path = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp')) / f'underlight-luma-{os.getuid()}.lock'
    lock = lock_path.open('a+')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        if args.menu:
            lock.seek(0)
            try: os.kill(int(lock.read().strip()), signal.SIGUSR1)
            except (ValueError, ProcessLookupError): pass
        return
    lock.seek(0); lock.truncate(); lock.write(str(os.getpid())); lock.flush()
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('GLibUnix', '2.0')
    from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, GLibUnix, Pango

    class Luma:
        def __init__(self):
            self.state = read_state()
            self.hover = False
            self.open = False
            self.last_poll = 0
            self.launches = []
            self.layer = ctypes.CDLL('libgtk-layer-shell.so.0')
            for name, types in {
                'init_for_window': [ctypes.c_void_p],
                'set_namespace': [ctypes.c_void_p, ctypes.c_char_p],
                'set_layer': [ctypes.c_void_p, ctypes.c_int],
                'set_anchor': [ctypes.c_void_p, ctypes.c_int, ctypes.c_bool],
                'set_margin': [ctypes.c_void_p, ctypes.c_int, ctypes.c_int],
                'set_exclusive_zone': [ctypes.c_void_p, ctypes.c_int],
                'set_keyboard_mode': [ctypes.c_void_p, ctypes.c_int],
            }.items():
                getattr(self.layer, 'gtk_layer_' + name).argtypes = types
            css = Gtk.CssProvider()
            css.load_from_data(b'''window {background:transparent;} .luma-panel {background:linear-gradient(135deg,rgba(70,95,130,.57),rgba(12,19,35,.65));color:#e6eeff;border:1px solid rgba(218,242,255,.5);border-radius:24px;padding:18px;box-shadow:inset 0 1px rgba(255,255,255,.35);} .luma-panel button {background:rgba(168,198,231,.08);color:#e6eeff;border:1px solid rgba(218,242,255,.12);border-radius:12px;padding:8px;margin:2px;} .luma-panel button:hover {background:rgba(136,221,238,.22);} .luma-panel .selected {background:rgba(99,203,228,.19);border-color:rgba(169,237,255,.5);} .luma-title {font-size:20px;color:#b4f2ff;}''')
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, 600)
            sheet = GdkPixbuf.Pixbuf.new_from_file(str(ASSETS / 'avatar.png'))
            w, h = sheet.get_width() // 2, sheet.get_height() // 2
            self.poses = [sheet.new_subpixbuf(x*w, y*h, w, h).scale_simple(110, 110, GdkPixbuf.InterpType.BILINEAR) for y in range(2) for x in range(2)]
            self.avatar = self.window('underlight-luma', 20, 0)
            self.canvas = Gtk.EventBox()
            self.canvas.set_visible_window(False)
            self.stage = Gtk.Fixed()
            self.portrait = Gtk.Image.new_from_pixbuf(self.poses[0])
            self.stage.put(self.portrait, 4, 7)
            self.canvas.add(self.stage)
            self.canvas.set_size_request(118, 132)
            self.canvas.set_can_focus(True)
            self.canvas.set_tooltip_text('Luma · click to open AI tools · right-click to switch sides')
            self.canvas.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
            self.canvas.connect('button-press-event', self.click)
            self.canvas.connect('enter-notify-event', lambda *_: setattr(self, 'hover', True))
            self.canvas.connect('leave-notify-event', lambda *_: setattr(self, 'hover', False))
            self.canvas.connect('key-press-event', self.key)
            self.avatar.add(self.canvas)
            self.panel = self.window('underlight-luma-panel', PANEL_BOTTOM, 2)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            box.get_style_context().add_class('luma-panel')
            title = Gtk.Label(label='Luma / your AI corner'); title.get_style_context().add_class('luma-title')
            box.pack_start(title, False, False, 3)
            self.privacy_label = Gtk.Label()
            self.privacy_label.set_line_wrap(True)
            self.privacy_label.set_max_width_chars(44)
            box.pack_start(self.privacy_label, False, False, 3)
            privacy_button = Gtk.Button(label='Privacy controls')
            privacy_button.connect('clicked', lambda *_: subprocess.Popen(
                [str(Path(__file__).resolve().with_name('underlight-privacy')), 'menu']))
            box.pack_start(privacy_button, False, False, 0)
            self.buttons = {}
            for agent in AGENTS:
                button = Gtk.Button(label=agent['name'])
                button.set_tooltip_text(agent['detail'])
                button.connect('clicked', self.choose, agent)
                box.pack_start(button, False, False, 0)
                self.buttons[agent['id']] = button
            self.status = Gtk.Label(label='Choose an AI to open it.'); self.status.set_line_wrap(True)
            self.status.set_max_width_chars(46)
            self.status.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            self.status.set_selectable(True)
            box.pack_start(self.status, False, False, 3)
            controls = Gtk.Box(spacing=4)
            for title, action in [('Motion', self.motion), ('Dock', self.dock), ('Hide', self.hide)]:
                b = Gtk.Button(label=title); b.connect('clicked', action); controls.pack_start(b, True, True, 0)
            box.pack_start(controls, False, False, 0)
            close = Gtk.Button(label='Close'); close.connect('clicked', lambda *_: self.toggle(False)); box.pack_start(close, False, False, 0)
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.set_propagate_natural_width(True)
            scroller.set_propagate_natural_height(True)
            scroller.add(box)
            self.panel.add(scroller)
            self.panel_box, self.scroller = box, scroller
            # gtk-layer-shell sizes this popup from its minimum requisition.
            # propagate_natural_height alone leaves a one-line viewport.
            box.show_all()
            self.resize_panel()
            self.panel.connect('key-press-event', self.key)
            self.apply()
            GLib.timeout_add(50, self.tick)

        def window(self, name, bottom, keyboard):
            win = Gtk.Window(); win.set_decorated(False); win.set_app_paintable(True)
            win.set_visual(win.get_screen().get_rgba_visual()); win.set_title(name)
            p = ctypes.c_void_p(hash(win))
            self.layer.gtk_layer_init_for_window(p)
            self.layer.gtk_layer_set_namespace(p, name.encode())
            self.layer.gtk_layer_set_layer(p, 2)
            self.layer.gtk_layer_set_keyboard_mode(p, keyboard)
            self.layer.gtk_layer_set_exclusive_zone(p, 0)
            self.layer.gtk_layer_set_anchor(p, 3, True)
            self.layer.gtk_layer_set_margin(p, 3, bottom)
            return win

        def apply(self):
            left = self.state.get('dock') == 'left'
            for win in [self.avatar, self.panel]:
                p = ctypes.c_void_p(hash(win))
                for edge in [0, 1]:
                    self.layer.gtk_layer_set_anchor(p, edge, (edge == 0) == left)
                    self.layer.gtk_layer_set_margin(p, edge, 18)
            for key, button in self.buttons.items():
                ctx = button.get_style_context()
                (ctx.add_class if key == self.state.get('selected', 'opencode') else ctx.remove_class)('selected')
            if self.state.get('desktopHidden'):
                self.avatar.hide(); self.toggle(False)
            else:
                self.avatar.show_all()

        def animate(self):
            moving = self.state.get('motion', True)
            y = 7 + (math.sin(time.monotonic()*1.8)*4 if moving else 0)
            self.portrait.set_from_pixbuf(self.poses[1 if self.hover or self.open else 0])
            self.stage.move(self.portrait, 4, int(y))

        def tick(self):
            for job in self.launches[:]:
                code = job.process.poll()
                if code is not None:
                    if code:
                        self.status.set_text(job.failure(code))
                        if not self.state.get('desktopHidden'):
                            self.toggle(True)
                    else:
                        self.status.set_text(f'{job.name} launcher finished.')
                    job.log.close()
                    self.launches.remove(job)
                elif not job.announced and time.monotonic() - job.started >= 1:
                    job.announced = True
                    self.status.set_text(f'{job.name} started. Check its window to continue.')
            if time.monotonic() - self.last_poll > 1:
                self.last_poll = time.monotonic(); state = read_state()
                try:
                    selected = privacy_mode()
                    self.privacy_label.set_text(f'{selected}: {MODES[selected]}')
                except (OSError, ValueError) as error:
                    self.privacy_label.set_text(str(error))
                if state != self.state: self.state = state; self.apply()
                if self.open:
                    self.resize_panel()
            if not self.state.get('desktopHidden'): self.animate()
            return True

        def toggle(self, value=None):
            self.open = not self.open if value is None else value
            if self.open:
                self.resize_panel()
            self.panel.show_all() if self.open else self.panel.hide()

        def resize_panel(self):
            display = Gdk.Display.get_default()
            window = self.avatar.get_window()
            monitor = (display.get_monitor_at_window(window) if window else None)
            monitor = monitor or display.get_primary_monitor() or display.get_monitor(0)
            if monitor is None:
                return
            geometry = monitor.get_geometry()
            width, _ = panel_size(geometry.width, geometry.height, 1)
            natural_height = self.panel_box.get_preferred_height_for_width(width)[1]
            width, height = panel_size(geometry.width, geometry.height, natural_height)
            if getattr(self, '_panel_size', None) == (width, height):
                return
            self._panel_size = width, height
            self.scroller.set_min_content_height(-1)
            self.scroller.set_max_content_height(height)
            self.scroller.set_min_content_height(height)
            self.scroller.set_min_content_width(-1)
            self.scroller.set_max_content_width(-1)
            self.scroller.set_min_content_width(width)
            self.scroller.set_max_content_width(width)
            self.scroller.set_size_request(width, height)
            self.panel.resize(width, height)

        def click(self, _, event):
            self.dock() if event.button == 3 else self.toggle()
            return True

        def key(self, _, event):
            if event.keyval == Gdk.KEY_Escape:
                self.toggle(False)
                return True
            if _ is self.canvas and event.keyval in [Gdk.KEY_Return, Gdk.KEY_space]:
                self.toggle()
                return True
            return False

        def dock(self, *_):
            self.state = save_state(dock='right' if self.state.get('dock') == 'left' else 'left'); self.apply()

        def motion(self, *_):
            self.state = save_state(motion=not self.state.get('motion', True))

        def hide(self, *_):
            self.state = save_state(desktopHidden=True); self.apply()

        def choose(self, _, agent):
            self.state = save_state(selected=agent['id']); self.apply()
            if any(job.name == agent['name'] and not job.announced for job in self.launches):
                return
            try:
                self.launches.append(LaunchJob(agent, self.state))
                self.status.set_text(f'Opening {agent["name"]}...')
            except (OSError, ValueError) as e:
                self.status.set_text(str(e))

    companion = Luma()
    def open_menu():
        companion.state = save_state(desktopHidden=False)
        companion.apply(); companion.toggle(True)
        return True
    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, open_menu)
    if args.menu: open_menu()
    Gtk.main()


if __name__ == '__main__':
    main()
