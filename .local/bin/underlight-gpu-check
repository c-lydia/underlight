#!/usr/bin/env bash

set -uo pipefail

section() { printf '\n%s\n' "$1"; }

if [[ ${1:-} == --terminal ]]; then
  if command -v kitty >/dev/null 2>&1; then
    exec kitty --class underlight-gpu-check --title 'GPU readiness' \
      sh -lc 'underlight-gpu-check; printf "\nPress Enter to close..."; read -r _'
  fi
  printf 'underlight-gpu-check: kitty is not installed\n' >&2
  exit 1
fi

printf 'Underlight hybrid-GPU readiness\n'

section 'Display controllers'
if command -v lspci >/dev/null 2>&1; then
  lspci -nnk -d ::03xx 2>/dev/null || lspci -nnk 2>/dev/null | sed -n '/VGA\|3D controller/,+3p'
else
  printf 'lspci is unavailable\n'
fi

section 'DRM render nodes'
if [[ -d /dev/dri ]]; then
  ls -l /dev/dri /dev/dri/by-path 2>/dev/null || true
else
  printf '/dev/dri is unavailable in this environment\n'
fi

section 'NVIDIA DRM modesetting'
if [[ -r /sys/module/nvidia_drm/parameters/modeset ]]; then
  modeset=$(</sys/module/nvidia_drm/parameters/modeset)
  if [[ $modeset == Y ]]; then
    printf 'enabled\n'
  else
    printf 'disabled (Hyprland requires nvidia_drm modesetting)\n'
  fi
else
  printf 'nvidia_drm is not loaded or its state is not readable\n'
fi

section 'NVIDIA driver and telemetry'
if command -v nvidia-smi >/dev/null 2>&1; then
  gpu_line=$(nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader 2>&1)
  printf '%s\n' "$gpu_line"
  if [[ $gpu_line == *'Driver/library version mismatch'* ]]; then
    printf 'Save your work and reboot to load the updated NVIDIA kernel module.\n'
  fi
  if [[ -r /proc/driver/nvidia/version ]]; then
    cat /proc/driver/nvidia/version
  fi
  if command -v modinfo >/dev/null 2>&1; then
    printf 'Installed kernel module: '
    modinfo -F version nvidia 2>/dev/null || true
  fi
else
  printf 'nvidia-smi is not installed\n'
fi

section 'CUDA toolkit'
if command -v nvcc >/dev/null 2>&1; then
  printf 'Selected compiler: %s\n' "$(command -v nvcc)"
  nvcc --version 2>&1 || true
else
  printf 'nvcc is not on PATH\n'
fi
if [[ -x /usr/local/cuda/bin/nvcc ]] && [[ ! $(command -v nvcc) -ef /usr/local/cuda/bin/nvcc ]]; then
  printf 'System toolkit: /usr/local/cuda/bin/nvcc\n'
  printf 'To select it, source ~/.config/underlight/cuda.sh (unless using a custom toolkit).\n'
fi

section 'PRIME launcher'
if command -v switcherooctl >/dev/null 2>&1; then
  gpu_list=$(switcherooctl list 2>&1 || true)
  if [[ -n ${gpu_list//[[:space:]]/} ]]; then
    printf '%s\n' "$gpu_list"
  else
    printf 'switcheroo-control is installed but its service returned no GPUs\n'
  fi
else
  printf 'switcheroo-control is not installed; underlight-gpu-run will use PRIME variables\n'
fi

section 'Usage'
printf '%s\n' \
  'underlight-gpu-run glxinfo -B' \
  'underlight-gpu-run vkcube' \
  'underlight-gpu-run steam'
