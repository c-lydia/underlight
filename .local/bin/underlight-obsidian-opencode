#!/usr/bin/env bash
# Keep the Student-compatible build and its database separate from other OpenCode installs.
set -euo pipefail
root="$HOME/.local/share/underlight/obsidian-opencode"
export UNDERLIGHT_HOST_XDG_CONFIG_HOME="${UNDERLIGHT_HOST_XDG_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}"
export UNDERLIGHT_HOST_XDG_DATA_HOME="${UNDERLIGHT_HOST_XDG_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}}"
export UNDERLIGHT_HOST_XDG_STATE_HOME="${UNDERLIGHT_HOST_XDG_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}"
export UNDERLIGHT_HOST_XDG_CACHE_HOME="${UNDERLIGHT_HOST_XDG_CACHE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}}"
export XDG_CONFIG_HOME="$root/config"
export XDG_DATA_HOME="$root/data"
export XDG_STATE_HOME="$root/state"
export XDG_CACHE_HOME="$root/cache"
binary="$HOME/.local/share/underlight/opencode-student/bin/opencode"
if [[ ! -x $binary ]]; then
  printf 'Student-compatible OpenCode is not installed: %s\n' "$binary" >&2
  exit 1
fi
exec "$binary" "$@"
