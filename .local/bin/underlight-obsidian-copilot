#!/usr/bin/env bash
# Use the same GitHub Copilot CLI and login as the host terminal.
set -euo pipefail
config="$PWD/.obsidian/underlight-rag.yaml"
if [[ -f /.flatpak-info ]]; then
  if [[ -f $config ]]; then
    exec flatpak-spawn --host --directory="$PWD" env RAG_CONFIG="$config" "$HOME/.local/bin/copilot" "$@"
  fi
  exec flatpak-spawn --host --directory="$PWD" "$HOME/.local/bin/copilot" "$@"
fi
if [[ -f $config ]]; then export RAG_CONFIG="$config"; fi
exec "$HOME/.local/bin/copilot" "$@"
