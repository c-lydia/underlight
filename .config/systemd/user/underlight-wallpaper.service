[Unit]
Description=Underlight Hyprpaper wallpaper
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Direct Hyprland logins do not necessarily activate graphical-session.target.
# Stop retrying once the compositor socket disappears at logout.
ExecCondition=/bin/sh -c 'test -n "${WAYLAND_DISPLAY}" && test -S "%t/${WAYLAND_DISPLAY}"'
ExecStart=/usr/bin/hyprpaper
Restart=always
RestartSec=5
